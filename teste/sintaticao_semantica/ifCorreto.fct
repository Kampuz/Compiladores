program ifCorreto;
 
int  a, b, c, d, e, f;
boolean     g;

begin  
    if ((a > 0) and (g or (b > 0))) then 		// IF correto
        write (a)				// Neste caso apenas um comando, se fossem mais, seria necessario utilizar begin/end
    else				//Opcional
       write (d);

    if (a > 0) then			//Caso IF com 3 comandos internos. Utilizando begin/end
       begin
            d := e*3;
            e := f div 4 + d div 2;
            while a > 0 do
                 a := a - 1
       end 
end.